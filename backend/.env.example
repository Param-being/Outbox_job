# ==============================================================================
# REACHINBOX EMAIL JOB SCHEDULER - BACKEND ENVIRONMENT EXAMPLE
# ==============================================================================

PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=50

DATABASE_URL="postgresql://reachinbox:reachinbox_password@localhost:5432/reachinbox_db?schema=public"

REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

ELASTICSEARCH_NODE="http://localhost:9200"

SLACK_DEFAULT_WEBHOOK_URL="https://hooks.slack.com/services/T000/B000/XXXX"
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

ETHEREAL_USER=""
ETHEREAL_PASS=""
ETHEREAL_HOST="smtp.ethereal.email"
ETHEREAL_PORT=587
